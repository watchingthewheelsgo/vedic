{
  "$defs": {
    "DiscriminatorOption": {
      "additionalProperties": false,
      "properties": {
        "optionId": {
          "title": "Optionid",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "supportsCandidateIds": {
          "items": {
            "type": "string"
          },
          "title": "Supportscandidateids",
          "type": "array"
        },
        "contradictsCandidateIds": {
          "items": {
            "type": "string"
          },
          "title": "Contradictscandidateids",
          "type": "array"
        }
      },
      "required": ["optionId", "label"],
      "title": "DiscriminatorOption",
      "type": "object"
    },
    "RectificationQuestion": {
      "additionalProperties": false,
      "properties": {
        "questionId": {
          "title": "Questionid",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "answerKind": {
          "enum": ["single_choice", "multiple_choice", "date", "short_text"],
          "title": "Answerkind",
          "type": "string"
        },
        "discriminatingFactIds": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Discriminatingfactids",
          "type": "array"
        },
        "candidateIds": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Candidateids",
          "type": "array"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/DiscriminatorOption"
          },
          "title": "Options",
          "type": "array"
        },
        "whyAsked": {
          "title": "Whyasked",
          "type": "string"
        },
        "prohibitedInference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prohibitedinference"
        }
      },
      "required": [
        "questionId",
        "prompt",
        "answerKind",
        "discriminatingFactIds",
        "candidateIds",
        "whyAsked"
      ],
      "title": "RectificationQuestion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "vedicdust-question-set/1.0.0",
      "default": "vedicdust-question-set/1.0.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "chartRecordId": {
      "title": "Chartrecordid",
      "type": "string"
    },
    "round": {
      "minimum": 1,
      "title": "Round",
      "type": "integer"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/RectificationQuestion"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Questions",
      "type": "array"
    },
    "completionCondition": {
      "title": "Completioncondition",
      "type": "string"
    }
  },
  "required": ["chartRecordId", "round", "questions", "completionCondition"],
  "title": "RectificationQuestionSet",
  "type": "object"
}
