{
  "$defs": {
    "TimeRange": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        }
      },
      "required": ["start", "end"],
      "title": "TimeRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The complete evidence package visible to the source-blind run operator.",
  "properties": {
    "schemaVersion": {
      "const": "vedicdust-rectification-blind-input/1.0.0",
      "default": "vedicdust-rectification-blind-input/1.0.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "caseId": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$",
      "title": "Caseid",
      "type": "string"
    },
    "birthInput": {
      "additionalProperties": true,
      "title": "Birthinput",
      "type": "object"
    },
    "lifeEvents": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "maxItems": 5,
      "minItems": 4,
      "title": "Lifeevents",
      "type": "array"
    },
    "reportedWindow": {
      "$ref": "#/$defs/TimeRange"
    },
    "reportedWindowOrigin": {
      "enum": ["independent_subject_recall", "deterministic_truth_mask"],
      "title": "Reportedwindoworigin",
      "type": "string"
    },
    "eventEvidenceOrigin": {
      "enum": ["subject_interview", "public_documentary_record"],
      "title": "Eventevidenceorigin",
      "type": "string"
    },
    "candidateContrastsExposed": {
      "default": false,
      "title": "Candidatecontrastsexposed",
      "type": "boolean"
    }
  },
  "required": [
    "caseId",
    "birthInput",
    "lifeEvents",
    "reportedWindow",
    "reportedWindowOrigin",
    "eventEvidenceOrigin"
  ],
  "title": "RectificationBenchmarkBlindInput",
  "type": "object"
}
