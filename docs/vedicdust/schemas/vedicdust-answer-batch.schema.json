{
  "$defs": {
    "RectificationAnswer": {
      "additionalProperties": false,
      "properties": {
        "questionId": {
          "title": "Questionid",
          "type": "string"
        },
        "selectedOptionIds": {
          "items": {
            "type": "string"
          },
          "title": "Selectedoptionids",
          "type": "array"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "eventInterval": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "enum": ["certain", "fairly_certain", "uncertain", "unknown"],
          "title": "Confidence",
          "type": "string"
        }
      },
      "required": ["questionId", "confidence"],
      "title": "RectificationAnswer",
      "type": "object"
    },
    "TimeRange": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        }
      },
      "required": ["start", "end"],
      "title": "TimeRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "vedicdust-answer-batch/1.0.0",
      "default": "vedicdust-answer-batch/1.0.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "chartRecordId": {
      "title": "Chartrecordid",
      "type": "string"
    },
    "round": {
      "minimum": 1,
      "title": "Round",
      "type": "integer"
    },
    "answers": {
      "items": {
        "$ref": "#/$defs/RectificationAnswer"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Answers",
      "type": "array"
    }
  },
  "required": ["chartRecordId", "round", "answers"],
  "title": "RectificationAnswerBatch",
  "type": "object"
}
