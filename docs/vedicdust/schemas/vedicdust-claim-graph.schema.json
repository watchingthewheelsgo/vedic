{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claimId": {
          "title": "Claimid",
          "type": "string"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "plainStatement": {
          "title": "Plainstatement",
          "type": "string"
        },
        "technicalStatement": {
          "title": "Technicalstatement",
          "type": "string"
        },
        "realWorldExpressions": {
          "items": {
            "type": "string"
          },
          "title": "Realworldexpressions",
          "type": "array"
        },
        "userRelevance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Userrelevance"
        },
        "conditions": {
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "supportingFactIds": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supportingfactids",
          "type": "array"
        },
        "counterFactIds": {
          "items": {
            "type": "string"
          },
          "title": "Counterfactids",
          "type": "array"
        },
        "timingFactIds": {
          "items": {
            "type": "string"
          },
          "title": "Timingfactids",
          "type": "array"
        },
        "timingPeriodIds": {
          "items": {
            "type": "string"
          },
          "title": "Timingperiodids",
          "type": "array"
        },
        "ruleIds": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Ruleids",
          "type": "array"
        },
        "certainty": {
          "enum": ["high", "moderate", "low", "withheld"],
          "title": "Certainty",
          "type": "string"
        },
        "scope": {
          "enum": ["natal_promise", "capacity", "timing", "rectification", "context"],
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "default": "supported",
          "enum": ["supported", "tentative", "withheld"],
          "title": "Status",
          "type": "string"
        },
        "timeScope": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "practicalImplications": {
          "items": {
            "type": "string"
          },
          "title": "Practicalimplications",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "claimId",
        "topic",
        "plainStatement",
        "technicalStatement",
        "supportingFactIds",
        "ruleIds",
        "certainty",
        "scope"
      ],
      "title": "Claim",
      "type": "object"
    },
    "QualityCheck": {
      "additionalProperties": false,
      "properties": {
        "checkId": {
          "title": "Checkid",
          "type": "string"
        },
        "status": {
          "enum": ["passed", "warning", "failed", "not_run"],
          "title": "Status",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "observed": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": ["checkId", "status", "message"],
      "title": "QualityCheck",
      "type": "object"
    },
    "TimeRange": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        }
      },
      "required": ["start", "end"],
      "title": "TimeRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "vedicdust-claim-graph/1.0.0",
      "default": "vedicdust-claim-graph/1.0.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "chartRecordId": {
      "title": "Chartrecordid",
      "type": "string"
    },
    "chartRevision": {
      "default": 1,
      "minimum": 1,
      "title": "Chartrevision",
      "type": "integer"
    },
    "methodProfileId": {
      "title": "Methodprofileid",
      "type": "string"
    },
    "rulePackVersion": {
      "title": "Rulepackversion",
      "type": "string"
    },
    "generatedAt": {
      "format": "date-time",
      "title": "Generatedat",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "omittedTopics": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Omittedtopics",
      "type": "object"
    },
    "qualityChecks": {
      "items": {
        "$ref": "#/$defs/QualityCheck"
      },
      "title": "Qualitychecks",
      "type": "array"
    }
  },
  "required": ["chartRecordId", "methodProfileId", "rulePackVersion", "generatedAt", "claims"],
  "title": "ClaimGraph",
  "type": "object"
}
