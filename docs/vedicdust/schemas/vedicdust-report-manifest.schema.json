{
  "$defs": {
    "GroundedNarrative": {
      "additionalProperties": false,
      "properties": {
        "narrativeId": {
          "title": "Narrativeid",
          "type": "string"
        },
        "kind": {
          "enum": ["synthesis", "integration", "reflection"],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 900,
          "minLength": 20,
          "title": "Text",
          "type": "string"
        },
        "claimIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Claimids",
          "type": "array"
        }
      },
      "required": ["narrativeId", "kind", "text", "claimIds"],
      "title": "GroundedNarrative",
      "type": "object"
    },
    "ReportSection": {
      "additionalProperties": false,
      "properties": {
        "sectionId": {
          "title": "Sectionid",
          "type": "string"
        },
        "sectionKind": {
          "enum": [
            "scope",
            "executive_synthesis",
            "chart_foundation",
            "core_architecture",
            "priority_domain",
            "timing_outlook",
            "decision_support",
            "follow_up",
            "technical_evidence"
          ],
          "title": "Sectionkind",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "claimIds": {
          "items": {
            "type": "string"
          },
          "title": "Claimids",
          "type": "array"
        },
        "timingWindowIds": {
          "items": {
            "type": "string"
          },
          "title": "Timingwindowids",
          "type": "array"
        },
        "visualRefs": {
          "items": {
            "type": "string"
          },
          "title": "Visualrefs",
          "type": "array"
        },
        "narratives": {
          "items": {
            "$ref": "#/$defs/GroundedNarrative"
          },
          "maxItems": 2,
          "title": "Narratives",
          "type": "array"
        },
        "priority": {
          "default": 100,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "confidenceDisclosureRequired": {
          "default": false,
          "title": "Confidencedisclosurerequired",
          "type": "boolean"
        }
      },
      "required": ["sectionId", "sectionKind", "title", "purpose"],
      "title": "ReportSection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "vedicdust-report-manifest/1.0.0",
      "default": "vedicdust-report-manifest/1.0.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "dossierId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dossierid"
    },
    "chartRecordId": {
      "title": "Chartrecordid",
      "type": "string"
    },
    "chartRevision": {
      "default": 1,
      "minimum": 1,
      "title": "Chartrevision",
      "type": "integer"
    },
    "claimGraphVersion": {
      "const": "vedicdust-claim-graph/1.6.0",
      "title": "Claimgraphversion",
      "type": "string"
    },
    "generatedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generatedat"
    },
    "locale": {
      "enum": ["zh", "en", "ja"],
      "title": "Locale",
      "type": "string"
    },
    "audience": {
      "enum": ["self", "parent", "partner", "family", "professional"],
      "title": "Audience",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/ReportSection"
      },
      "title": "Sections",
      "type": "array"
    },
    "omittedClaimIds": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Omittedclaimids",
      "type": "object"
    },
    "releaseStatus": {
      "enum": ["draft", "approved", "blocked"],
      "title": "Releasestatus",
      "type": "string"
    }
  },
  "required": [
    "chartRecordId",
    "claimGraphVersion",
    "locale",
    "audience",
    "sections",
    "releaseStatus"
  ],
  "title": "ConsultationReportManifest",
  "type": "object"
}
