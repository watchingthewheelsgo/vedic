{
  "$defs": {
    "RectificationBenchmarkCase": {
      "additionalProperties": false,
      "properties": {
        "caseId": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$",
          "title": "Caseid",
          "type": "string"
        },
        "chartRecord": {
          "$ref": "#/$defs/RetainedBenchmarkArtifact"
        },
        "blindInput": {
          "$ref": "#/$defs/RetainedBenchmarkArtifact"
        },
        "runReceipt": {
          "$ref": "#/$defs/RetainedBenchmarkArtifact"
        },
        "truthInterval": {
          "$ref": "#/$defs/TimeRange"
        },
        "truthSourceRating": {
          "enum": ["AA", "A", "B", "C", "DD"],
          "title": "Truthsourcerating",
          "type": "string"
        },
        "truthSourceReference": {
          "minLength": 3,
          "title": "Truthsourcereference",
          "type": "string"
        },
        "truthSourceUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Truthsourceurl"
        },
        "truthSourceArtifact": {
          "$ref": "#/$defs/RetainedBenchmarkArtifact"
        },
        "truthCommitmentSha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Truthcommitmentsha256",
          "type": "string"
        },
        "truthCommitmentSalt": {
          "minLength": 16,
          "title": "Truthcommitmentsalt",
          "type": "string"
        },
        "truthCommittedAt": {
          "format": "date-time",
          "title": "Truthcommittedat",
          "type": "string"
        },
        "runStartedAt": {
          "format": "date-time",
          "title": "Runstartedat",
          "type": "string"
        },
        "runCompletedAt": {
          "format": "date-time",
          "title": "Runcompletedat",
          "type": "string"
        },
        "truthRevealedAt": {
          "format": "date-time",
          "title": "Truthrevealedat",
          "type": "string"
        },
        "truthCustodianId": {
          "minLength": 3,
          "title": "Truthcustodianid",
          "type": "string"
        },
        "runOperatorId": {
          "minLength": 3,
          "title": "Runoperatorid",
          "type": "string"
        },
        "targetHiddenDuringRun": {
          "title": "Targethiddenduringrun",
          "type": "boolean"
        },
        "reportedWindowOrigin": {
          "enum": ["independent_subject_recall", "deterministic_truth_mask"],
          "title": "Reportedwindoworigin",
          "type": "string"
        },
        "independentRecallAttested": {
          "default": false,
          "title": "Independentrecallattested",
          "type": "boolean"
        },
        "maskingProtocolId": {
          "anyOf": [
            {
              "const": "vedicdust-deterministic-window-mask/1.0.0",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maskingprotocolid"
        },
        "maskingSeed": {
          "anyOf": [
            {
              "minLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maskingseed"
        },
        "maskingWindowMinutes": {
          "anyOf": [
            {
              "enum": [120, 240],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maskingwindowminutes"
        },
        "eventEvidenceOrigin": {
          "enum": ["subject_interview", "public_documentary_record"],
          "title": "Eventevidenceorigin",
          "type": "string"
        },
        "eventsCollectedWithoutCandidateContrast": {
          "title": "Eventscollectedwithoutcandidatecontrast",
          "type": "boolean"
        }
      },
      "required": [
        "caseId",
        "chartRecord",
        "blindInput",
        "runReceipt",
        "truthInterval",
        "truthSourceRating",
        "truthSourceReference",
        "truthSourceArtifact",
        "truthCommitmentSha256",
        "truthCommitmentSalt",
        "truthCommittedAt",
        "runStartedAt",
        "runCompletedAt",
        "truthRevealedAt",
        "truthCustodianId",
        "runOperatorId",
        "targetHiddenDuringRun",
        "reportedWindowOrigin",
        "eventEvidenceOrigin",
        "eventsCollectedWithoutCandidateContrast"
      ],
      "title": "RectificationBenchmarkCase",
      "type": "object"
    },
    "RetainedBenchmarkArtifact": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "retainedAt": {
          "format": "date-time",
          "title": "Retainedat",
          "type": "string"
        }
      },
      "required": ["path", "sha256", "retainedAt"],
      "title": "RetainedBenchmarkArtifact",
      "type": "object"
    },
    "TimeRange": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        }
      },
      "required": ["start", "end"],
      "title": "TimeRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "vedicdust-rectification-benchmark/1.1.0",
      "default": "vedicdust-rectification-benchmark/1.1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "benchmarkId": {
      "pattern": "^[a-z0-9][a-z0-9._/-]+$",
      "title": "Benchmarkid",
      "type": "string"
    },
    "protocolId": {
      "const": "vedicdust-source-blind-rectification/1.1.0",
      "default": "vedicdust-source-blind-rectification/1.1.0",
      "title": "Protocolid",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/RectificationBenchmarkCase"
      },
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    }
  },
  "required": ["benchmarkId", "createdAt", "cases"],
  "title": "RectificationBenchmarkArtifact",
  "type": "object"
}
