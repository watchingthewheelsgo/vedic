# VedicSign production deployment configuration.
#
# Copy with `./deploy.sh setup`; do not commit the generated `.env.production`.
# VITE_* values are embedded into the frontend bundle and require a rebuild.

APP_ENV=production
SITE_DOMAIN=vedicsign.ai
API_DOMAIN=api.vedicsign.ai
ALLOWED_ORIGINS=https://vedicsign.ai
VITE_API_BASE_URL=https://api.vedicsign.ai/v1

VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VEDIC_AUTH_MODE=clerk
VEDIC_ADMIN_USER_IDS=
VEDIC_ADMIN_EMAILS=

DATABASE_URL=
DATABASE_ECHO=false

DEEPSEEK_API_KEY=
VEDIC_AI_MODE=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
AGENT_EFFORT=max
AGENT_MAX_TURNS=8
AGENT_TIMEOUT_MS=420000
AGENT_TRANSIENT_RETRIES=2
AGENT_RETRY_BASE_DELAY_MS=750

AMAP_WEB_SERVICE_KEY=
AMAP_PLACE_FALLBACK_ENABLED=false

CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_TEST_MODE=true
CREEM_SUCCESS_URL=https://vedicsign.ai/account?billing=success
CREEM_PRODUCT_PRO_MONTHLY=
CREEM_PRODUCT_PRO_YEARLY=
CREEM_PRODUCT_SINGLE_REPORT=

HOST=0.0.0.0
PORT=8787
RELOAD=false
VEDICSIGN_UID=10001
VEDICSIGN_GID=10001
SESSION_DATA_DIR=/var/lib/vedicsign/sessions
BACKUP_DIR=/var/backups/vedicsign
